# Copie para .env (que NUNCA deve ser versionado):  cp .env.example .env
# Em produção (Railway) estas variáveis são configuradas no painel do serviço.

# ---------- API ----------
NODE_ENV=development
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=info
APP_VERSION=0.0.0

# PostgreSQL local do docker-compose. No Railway use a referência ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgres://fintrack:fintrack@localhost:5432/fintrack
DATABASE_POOL_MAX=10

# Testes de integração da API (banco separado, criado por database/init). Opcional.
TEST_DATABASE_URL=postgres://fintrack:fintrack@localhost:5432/fintrack_test

# Origens da web autorizadas no CORS (separadas por vírgula).
CORS_ORIGINS=http://localhost:5173

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# true atrás do proxy do Railway (IP real do cliente para o rate limit).
TRUST_PROXY=false

# Swagger UI em /docs (padrão: ligado fora de produção).
API_DOCS_ENABLED=true

# ---------- Autenticação ----------
# Segredo dos access tokens (JWT HS256). OBRIGATÓRIO em produção e no `docker compose --profile full`.
# Em desenvolvimento, se ficar vazio, a API gera um segredo temporário (sessões caem a cada restart).
# Gere com:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Cookie de refresh com atributo Secure (padrão: true em produção, false em desenvolvimento).
# AUTH_COOKIE_SECURE=

# ---------- docker compose ----------
POSTGRES_USER=fintrack
POSTGRES_PASSWORD=fintrack
POSTGRES_DB=fintrack
POSTGRES_PORT=5432
