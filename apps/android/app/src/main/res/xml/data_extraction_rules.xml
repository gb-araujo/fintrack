<?xml version="1.0" encoding="utf-8"?>
<!--
  App financeiro: nenhum dado local (tokens de sessão, cache) vai para backup na nuvem
  nem é copiado em transferência entre dispositivos. Os dados vivem no backend.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
